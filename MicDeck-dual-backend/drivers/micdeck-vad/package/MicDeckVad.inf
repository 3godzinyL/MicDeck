[Version]
Signature="$WINDOWS NT$"
Class=MEDIA
ClassGuid={4d36e96c-e325-11ce-bfc1-08002be10318}
Provider=%ProviderName%
DriverVer=07/26/2026,0.3.0.0
CatalogFile=MicDeckVad.cat
PnpLockdown=1

[Manufacturer]
%ProviderName%=MicDeck,NTamd64.10.0

[MicDeck.NTamd64.10.0]
%MicDeckVad.DeviceDesc%=MicDeckVad_Install,ROOT\MICDECKVAD

[SourceDisksFiles]
MicDeckVad.sys=1
[SourceDisksNames]
1=%DiskName%,,,
[DestinationDirs]
DefaultDestDir=13
MicDeckVad.CopyFiles=13

[MicDeckVad_Install.NT]
CopyFiles=MicDeckVad.CopyFiles
[MicDeckVad.CopyFiles]
MicDeckVad.sys

[MicDeckVad_Install.NT.Services]
AddService=MicDeckVad,0x00000002,MicDeckVad_Service
[MicDeckVad_Service]
DisplayName=%MicDeckVad.ServiceDesc%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%13%\MicDeckVad.sys
LoadOrderGroup=AudioGroup

[MicDeckVad_Install.NT.HW]
AddReg=MicDeckVad.Hardware.AddReg
[MicDeckVad.Hardware.AddReg]
HKR,,FriendlyName,0x00000000,%MicDeckVad.DeviceDesc%
HKR,,DriverVersion,0x00000000,"0.3.0"
HKR,,DriverAbi,0x00010001,3
HKR,,DefaultLatencyMode,0x00010001,1

[MicDeckVad_Install.NT.Interfaces]
AddInterface=%KSCATEGORY_AUDIO%,GLOBAL,MicDeckVad.Audio.Interface
AddInterface=%KSCATEGORY_RENDER%,GLOBAL,MicDeckVad.Render.Interface
AddInterface=%KSCATEGORY_CAPTURE%,GLOBAL,MicDeckVad.Capture.Interface

[MicDeckVad.Audio.Interface]
AddReg=MicDeckVad.Audio.AddReg
[MicDeckVad.Render.Interface]
AddReg=MicDeckVad.Render.AddReg
[MicDeckVad.Capture.Interface]
AddReg=MicDeckVad.Capture.AddReg

[MicDeckVad.Audio.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%MicDeckVad.DeviceDesc%
[MicDeckVad.Render.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%MicDeckVad.RenderName%
[MicDeckVad.Capture.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%MicDeckVad.CaptureName%

[Strings]
ProviderName="MicDeck Project"
DiskName="MicDeck Virtual Audio Driver installation media"
MicDeckVad.DeviceDesc="MicDeck Virtual Audio Cable"
MicDeckVad.ServiceDesc="MicDeck Virtual Audio Driver"
MicDeckVad.RenderName="MicDeck Driver Input"
MicDeckVad.CaptureName="MicDeck Virtual Microphone"
Proxy.CLSID="{17CCA71B-ECD7-11D0-B908-00A0C9223196}"
KSCATEGORY_AUDIO="{6994AD04-93EF-11D0-A3CC-00A0C9223196}"
KSCATEGORY_RENDER="{65E8773E-8F56-11D0-A3B9-00A0C9223196}"
KSCATEGORY_CAPTURE="{65E8773D-8F56-11D0-A3B9-00A0C9223196}"
